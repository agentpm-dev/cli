{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/agentpm-dev/cli/refs/heads/main/schemas/agentpm.manifest.schema.json",
  "type": "object",
  "additionalProperties": false,

  "$defs": {
    "packageRef": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^@[a-z][a-z0-9-]{0,63}/[a-z][a-z0-9-]{0,63}(?:@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:\\.(0|[1-9]\\d*))?(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)?$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "^@[a-z][a-z0-9-]{0,63}/[a-z][a-z0-9-]{0,63}$"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:\\.(0|[1-9]\\d*))?(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
            }
          }
        }
      ]
    },
    "promptExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "prompt"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version"],
      "properties": {
        "type": { "type": "string", "enum": ["python", "node"] },
        "version": {
          "type": "string",
          "description": "Minimum required runtime version",
          "pattern": "^\\d+(\\.\\d+){0,2}$"
        }
      }
    },
    "envVar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "description"],
      "properties": {
        "required": { "type": "boolean", "default": false },
        "description": { "type": "string" },
        "default": { "type": "string" }
      }
    },
    "templateVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "required"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Generation-time scaffold variable name. Use only for non-secret template values."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Describe how the scaffold value is used. Do not use template variables for API keys, tokens, passwords, or runtime secrets."
        },
        "required": { "type": "boolean" },
        "default": { "type": "string" }
      }
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\\\\\\\)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "memoryKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable identifier used for Memory Blueprint scopes, record types, spaces, and operations."
    },
    "memoryGovernanceDataClass": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "personal",
        "authentication",
        "financial",
        "health",
        "legal",
        "operational",
        "other"
      ],
      "description": "Supported AgentPM governance classification value for x-agentpm-data-class annotations in Memory content schemas."
    },
    "memoryGovernanceSensitivity": {
      "type": "string",
      "enum": ["low", "moderate", "high", "critical"],
      "description": "Supported AgentPM sensitivity value for x-agentpm-sensitivity annotations in Memory content schemas."
    },
    "memoryGovernanceAnnotations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x-agentpm-data-class": {
          "$ref": "#/$defs/memoryGovernanceDataClass"
        },
        "x-agentpm-sensitivity": {
          "$ref": "#/$defs/memoryGovernanceSensitivity"
        },
        "x-agentpm-persist": {
          "type": "boolean",
          "description": "Supported AgentPM governance flag for marking values as non-persistable durable memory."
        },
        "x-agentpm-shareable": {
          "type": "boolean",
          "description": "Supported AgentPM governance flag for restricting cross-boundary sharing."
        }
      },
      "description": "Supported AgentPM-owned governance annotation names and value types for Memory content schemas."
    },
    "memoryScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Required human-readable description of the logical scope key."
        }
      }
    },
    "memoryScopes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/memoryKey" },
      "additionalProperties": { "$ref": "#/$defs/memoryScope" },
      "description": "Author-declared reusable scope keys for the Memory Blueprint."
    },
    "memoryRecordType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "description", "schema"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "description": "Required semantic version for the authored record content schema."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Required human-readable description of the record type."
        },
        "schema": {
          "$ref": "#/$defs/safeRelativePath",
          "description": "Required safe package-relative path to the Draft 2020-12 JSON Schema for the record content payload."
        }
      }
    },
    "memoryRecordTypes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/memoryKey" },
      "additionalProperties": { "$ref": "#/$defs/memoryRecordType" },
      "description": "Author-declared record type contracts for the Memory Blueprint."
    },
    "memoryRetrievalMode": {
      "type": "string",
      "enum": ["key", "filter", "chronological", "full_text", "semantic"],
      "description": "Supported logical retrieval mode for a Memory space."
    },
    "memoryRetrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes"],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/memoryRetrievalMode" },
          "description": "Required unique set of logical retrieval capabilities that a compatible runtime must support."
        }
      }
    },
    "memoryCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_records"],
      "properties": {
        "max_records": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional declarative maximum record count for the space."
        }
      }
    },
    "memoryRetention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ttl", "on_expire"],
      "properties": {
        "ttl": {
          "type": "string",
          "minLength": 1,
          "description": "Required ISO 8601 duration string describing how long active records should remain available."
        },
        "on_expire": {
          "type": "string",
          "enum": ["delete", "archive"],
          "description": "Required declarative behavior for expired records."
        }
      }
    },
    "memoryConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "append_only": {
          "type": "boolean",
          "description": "Optional declarative constraint indicating that new records are appended rather than updated in place."
        }
      }
    },
    "memorySpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "model", "record_types", "scope", "retrieval"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Required human-readable description of the logical memory space."
        },
        "model": {
          "type": "string",
          "enum": ["document", "collection", "sequence"],
          "description": "Required logical storage model for the space."
        },
        "record_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/memoryKey" },
          "description": "Required unique list of record types permitted in the space."
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/memoryKey" },
          "description": "Required ordered scope keys that define the logical identity of records in the space."
        },
        "retrieval": {
          "$ref": "#/$defs/memoryRetrieval",
          "description": "Required logical retrieval capabilities for the space."
        },
        "capacity": {
          "$ref": "#/$defs/memoryCapacity",
          "description": "Optional declarative capacity metadata for the space."
        },
        "retention": {
          "$ref": "#/$defs/memoryRetention",
          "description": "Optional declarative retention metadata for the space."
        },
        "constraints": {
          "$ref": "#/$defs/memoryConstraints",
          "description": "Optional declarative constraints for the space."
        }
      }
    },
    "memorySpaces": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/memoryKey" },
      "additionalProperties": { "$ref": "#/$defs/memorySpace" },
      "description": "Author-declared logical spaces in the Memory Blueprint."
    },
    "memoryOperationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "record_type"],
      "properties": {
        "space": {
          "$ref": "#/$defs/memoryKey",
          "description": "Declared space key referenced by the operation."
        },
        "record_type": {
          "$ref": "#/$defs/memoryKey",
          "description": "Declared record type key referenced by the operation."
        }
      }
    },
    "memoryOperationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space"],
      "properties": {
        "space": {
          "$ref": "#/$defs/memoryKey",
          "description": "Declared target space key referenced by a delete operation."
        }
      }
    },
    "memoryTrigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "external",
              "description": "Operation is invoked by an external application, future binding, or harness."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "space", "threshold"],
          "properties": {
            "type": {
              "const": "record_count",
              "description": "Operation becomes eligible when a space reaches a record threshold."
            },
            "space": {
              "$ref": "#/$defs/memoryKey",
              "description": "Declared space key monitored by the trigger."
            },
            "threshold": {
              "type": "integer",
              "minimum": 1,
              "description": "Required positive record threshold."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "space"],
          "properties": {
            "type": {
              "const": "capacity",
              "description": "Operation becomes eligible when a space reaches its declared capacity."
            },
            "space": {
              "$ref": "#/$defs/memoryKey",
              "description": "Declared space key monitored by the trigger."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "every"],
          "properties": {
            "type": {
              "const": "interval",
              "description": "Operation becomes eligible on a recurring elapsed-time interval."
            },
            "every": {
              "type": "string",
              "minLength": 1,
              "description": "Required ISO 8601 duration string for the recurring interval."
            }
          }
        }
      ]
    },
    "memorySourceHandling": {
      "type": "string",
      "enum": ["retain", "retain_until_expiration", "delete_after_success"],
      "description": "Supported declarative source-handling policy for lifecycle operations."
    },
    "memoryConsolidateOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description",
        "trigger",
        "inputs",
        "output",
        "source_handling",
        "preserve_provenance"
      ],
      "properties": {
        "type": {
          "const": "consolidate",
          "description": "Operation converts one or more source records into a destination record."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Required human-readable description of the operation."
        },
        "trigger": {
          "$ref": "#/$defs/memoryTrigger",
          "description": "Required declarative trigger for the operation."
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/memoryOperationRef" },
          "description": "Required unique source space-and-record-type pairings."
        },
        "output": {
          "$ref": "#/$defs/memoryOperationRef",
          "description": "Required destination space-and-record-type pairing."
        },
        "source_handling": {
          "$ref": "#/$defs/memorySourceHandling",
          "description": "Required declarative policy for source records after successful completion."
        },
        "preserve_provenance": {
          "type": "boolean",
          "description": "Required flag indicating whether derived records should retain source provenance."
        }
      }
    },
    "memoryTransformOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description",
        "trigger",
        "inputs",
        "output",
        "source_handling",
        "preserve_provenance"
      ],
      "properties": {
        "type": {
          "const": "transform",
          "description": "Operation converts one source record contract into another record contract."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Required human-readable description of the operation."
        },
        "trigger": {
          "$ref": "#/$defs/memoryTrigger",
          "description": "Required declarative trigger for the operation."
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/memoryOperationRef" },
          "description": "Required single source space-and-record-type pairing."
        },
        "output": {
          "$ref": "#/$defs/memoryOperationRef",
          "description": "Required destination space-and-record-type pairing."
        },
        "source_handling": {
          "$ref": "#/$defs/memorySourceHandling",
          "description": "Required declarative policy for source records after successful completion."
        },
        "preserve_provenance": {
          "type": "boolean",
          "description": "Required flag indicating whether derived records should retain source provenance."
        }
      }
    },
    "memoryDeleteOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description", "trigger", "targets", "cascade_derived_records"],
      "properties": {
        "type": {
          "const": "delete",
          "description": "Operation declares a set of spaces that may be deleted as one lifecycle action."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Required human-readable description of the operation."
        },
        "trigger": {
          "$ref": "#/$defs/memoryTrigger",
          "description": "Required declarative trigger for the operation."
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/memoryOperationTarget" },
          "description": "Required unique set of target spaces affected by the delete operation."
        },
        "cascade_derived_records": {
          "type": "boolean",
          "description": "Required flag indicating whether derived records should also be removed."
        }
      }
    },
    "memoryOperation": {
      "oneOf": [
        { "$ref": "#/$defs/memoryConsolidateOperation" },
        { "$ref": "#/$defs/memoryTransformOperation" },
        { "$ref": "#/$defs/memoryDeleteOperation" }
      ],
      "description": "Supported declarative lifecycle operation contract for a Memory Blueprint."
    },
    "memoryOperations": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/memoryKey" },
      "additionalProperties": { "$ref": "#/$defs/memoryOperation" },
      "description": "Optional declarative lifecycle operations for the Memory Blueprint."
    },
    "memoryMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopes", "record_types", "spaces"],
      "properties": {
        "scopes": {
          "$ref": "#/$defs/memoryScopes",
          "description": "Required reusable scope declarations for the Memory Blueprint."
        },
        "record_types": {
          "$ref": "#/$defs/memoryRecordTypes",
          "description": "Required record type declarations for the Memory Blueprint."
        },
        "spaces": {
          "$ref": "#/$defs/memorySpaces",
          "description": "Required logical spaces declared by the Memory Blueprint."
        },
        "operations": {
          "$ref": "#/$defs/memoryOperations",
          "description": "Optional declarative lifecycle operations for the Memory Blueprint."
        }
      }
    },
    "skillCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "description": "Descriptive compatibility metadata for a Skill. These values are informational and not runtime-enforced.",
      "properties": {
        "model_families": {
          "type": "array",
          "description": "Optional open-ended model family labels the Skill was authored or reviewed against.",
          "items": { "type": "string", "minLength": 1 }
        },
        "runtimes": {
          "type": "array",
          "description": "Optional known runtimes or execution surfaces this Skill is intended to work well with.",
          "items": {
            "type": "string",
            "enum": ["agentpm-run", "shell", "python-sdk", "node-sdk", "markdown"]
          }
        },
        "environments": {
          "type": "array",
          "description": "Optional open-ended operating system, shell, or workspace environment labels assumed by the Skill.",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "skillMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint"],
      "description": "Skill-specific metadata describing the primary authored instructions and any supporting files packaged with the Skill.",
      "properties": {
        "entrypoint": {
          "$ref": "#/$defs/safeRelativePath",
          "description": "Required relative path to the main Skill instructions file, typically SKILL.md."
        },
        "references": {
          "type": "array",
          "description": "Optional additional authored reference files that support the Skill instructions.",
          "items": { "$ref": "#/$defs/safeRelativePath" }
        },
        "scripts": {
          "type": "array",
          "description": "Optional helper scripts packaged with the Skill for local execution or demonstration.",
          "items": { "$ref": "#/$defs/safeRelativePath" }
        },
        "compatibility": {
          "$ref": "#/$defs/skillCompatibility",
          "description": "Optional descriptive compatibility hints for models, runtimes, environments, or export targets."
        }
      }
    },
    "knowledgeDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "$ref": "#/$defs/safeRelativePath",
          "description": "Required relative path to a packaged document intended for direct context loading."
        },
        "content_type": {
          "type": "string",
          "minLength": 1,
          "description": "Optional MIME type or content classification for the document."
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "Optional role label describing how the document should be used, such as context or reference."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Optional human-readable note about the purpose of the document."
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional build-derived byte size of the declared document."
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "description": "Optional build-derived content hash for the declared document."
        }
      }
    },
    "knowledgeContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional build-derived count of declared context documents."
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional build-derived total byte size across declared context documents."
        },
        "content_hash": {
          "type": "string",
          "minLength": 1,
          "description": "Optional build-derived aggregate content hash for the context corpus."
        }
      }
    },
    "knowledgeCorpus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chunks_path": {
          "$ref": "#/$defs/safeRelativePath",
          "description": "Relative path to the packaged chunks JSONL file for vector-mode Knowledge."
        },
        "sources_path": {
          "$ref": "#/$defs/safeRelativePath",
          "description": "Relative path to the packaged sources JSONL file for vector-mode Knowledge."
        },
        "chunk_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional build-derived count of chunks in the vector corpus."
        },
        "source_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional build-derived count of unique sources in the vector corpus."
        },
        "content_hash": {
          "type": "string",
          "minLength": 1,
          "description": "Optional build-derived aggregate content hash for the chunks and sources payload."
        }
      }
    },
    "knowledgeChunking": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1,
          "description": "Optional open-ended label describing the chunking strategy used to prepare the corpus."
        },
        "chunk_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional chunk size used during corpus preparation."
        },
        "overlap": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional overlap size used during corpus preparation."
        }
      }
    },
    "knowledgeEmbedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "model", "dimensions", "metric", "normalized", "vectors_path"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Required embedding payload identifier, used to associate vectors and indexes."
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Required embedding provider label recorded for provenance and compatibility."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Required embedding model label recorded for provenance and compatibility."
        },
        "dimensions": {
          "type": "integer",
          "minimum": 1,
          "description": "Required vector dimensionality for the packaged embeddings."
        },
        "metric": {
          "type": "string",
          "minLength": 1,
          "description": "Required similarity metric label for the packaged embeddings."
        },
        "normalized": {
          "type": "boolean",
          "description": "Required flag indicating whether the packaged vectors are already normalized."
        },
        "vectors_path": {
          "$ref": "#/$defs/safeRelativePath",
          "description": "Required relative path to the packaged raw vector payload."
        },
        "vector_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional build-derived number of vectors in the packaged embedding payload."
        },
        "vectors_hash": {
          "type": "string",
          "minLength": 1,
          "description": "Optional build-derived hash of the packaged vector payload."
        }
      }
    },
    "knowledgeIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "embedding_id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Required index identifier, typically matching the default packaged retrieval index."
        },
        "type": {
          "type": "string",
          "enum": ["agentpm-local"],
          "description": "Required index type label for the packaged retrieval index."
        },
        "path": {
          "$ref": "#/$defs/safeRelativePath",
          "description": "Required relative path to the packaged local retrieval index directory or file."
        },
        "embedding_id": {
          "type": "string",
          "minLength": 1,
          "description": "Required embedding identifier that this index was built against."
        },
        "generated_by": {
          "type": "string",
          "minLength": 1,
          "description": "Optional generator label recorded for provenance, such as agentpm knowledge build."
        }
      }
    },
    "knowledgeRetrieval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1,
          "description": "Optional open-ended retrieval strategy label, such as full_context, vector, or future hybrid variants."
        },
        "default_top_k": {
          "type": "integer",
          "minimum": 1,
          "description": "Optional default result count to use during vector retrieval."
        },
        "default_score_threshold": {
          "type": "number",
          "description": "Optional score threshold hint for retrieval filtering."
        },
        "return_citations": {
          "type": "boolean",
          "description": "Optional flag indicating whether retrieval consumers should return citations by default."
        }
      }
    },
    "knowledgeBuilder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "knowledgeProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources_manifest_path": {
          "$ref": "#/$defs/safeRelativePath",
          "description": "Optional relative path to a detailed provenance or sources manifest packaged with the Knowledge artifact."
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Optional timestamp indicating when the Knowledge artifact metadata was generated."
        },
        "builder": {
          "$ref": "#/$defs/knowledgeBuilder",
          "description": "Optional builder metadata describing the process or tool that generated the packaged Knowledge metadata."
        }
      }
    },
    "knowledgeMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["context", "vector"],
          "description": "Required Knowledge artifact mode. Use context for direct-context document bundles and vector for prepared retrieval corpora."
        },
        "content_type": {
          "type": "string",
          "minLength": 1,
          "description": "Optional high-level content classification for the Knowledge artifact, such as documentation or policy."
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "description": "Optional primary language label for the packaged content."
        },
        "documents": {
          "type": "array",
          "items": { "$ref": "#/$defs/knowledgeDocument" },
          "description": "Declared documents packaged for direct context loading in context mode."
        },
        "context": {
          "$ref": "#/$defs/knowledgeContext",
          "description": "Optional build-derived aggregate metadata for context-mode documents."
        },
        "corpus": {
          "$ref": "#/$defs/knowledgeCorpus",
          "description": "Vector-mode corpus metadata describing packaged chunks and sources."
        },
        "chunking": {
          "$ref": "#/$defs/knowledgeChunking",
          "description": "Optional descriptive metadata about how the vector corpus was chunked."
        },
        "embedding": {
          "$ref": "#/$defs/knowledgeEmbedding",
          "description": "Vector-mode embedding metadata describing the packaged vectors."
        },
        "indexes": {
          "type": "array",
          "items": { "$ref": "#/$defs/knowledgeIndex" },
          "description": "Optional packaged retrieval indexes associated with the vector corpus."
        },
        "retrieval": {
          "$ref": "#/$defs/knowledgeRetrieval",
          "description": "Optional retrieval defaults or strategy hints for consumers of the Knowledge artifact."
        },
        "provenance": {
          "$ref": "#/$defs/knowledgeProvenance",
          "description": "Optional provenance metadata describing how the Knowledge artifact was generated."
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": { "const": "context" }
          }
        },
        {
          "properties": {
            "mode": { "const": "vector" }
          },
          "required": ["corpus", "embedding"],
          "allOf": [
            {
              "properties": {
                "corpus": {
                  "required": ["chunks_path", "sources_path"]
                }
              }
            },
            {
              "properties": {
                "embedding": {
                  "required": ["id", "provider", "model", "dimensions", "metric", "normalized", "vectors_path"]
                }
              }
            }
          ]
        }
      ]
    },
    "templateDependencyGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "agents"],
      "properties": {
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/packageRef" }
        },
        "agents": {
          "type": "array",
          "items": { "$ref": "#/$defs/packageRef" }
        },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/packageRef" }
        },
        "knowledge": {
          "type": "array",
          "items": { "$ref": "#/$defs/packageRef" }
        },
        "memory": {
          "type": "array",
          "items": { "$ref": "#/$defs/packageRef" }
        }
      }
    },
    "templateEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "command"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "templateMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "use_case",
        "execution_surfaces",
        "files_root",
        "dependencies",
        "entrypoints"
      ],
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "use_case": { "type": "string", "minLength": 1 },
        "stack": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["python", "node", "shell", "mcp", "workspace"]
          }
        },
        "execution_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "python-sdk",
              "node-sdk",
              "agentpm-run",
              "agentpm-serve-mcp",
              "multi-agent-workspace"
            ]
          }
        },
        "files_root": {
          "$ref": "#/$defs/safeRelativePath",
          "description": "Relative directory inside the template artifact that is copied into the generated project. Template text rendering uses {{ variable_name }} placeholders."
        },
        "variables": {
          "type": "array",
          "items": { "$ref": "#/$defs/templateVariable" },
          "description": "Generation-time scaffold variables only. Do not use for API keys, tokens, passwords, or runtime secrets."
        },
        "dependencies": { "$ref": "#/$defs/templateDependencyGroup" },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/templateEntrypoint" }
        }
      }
    }
  },

  "dependentSchemas": {
    "tools":      { "properties": { "kind": { "enum": ["agent", "skill"] } } },
    "examples":   { "properties": { "kind": { "const": "agent" } } },
    "skills":     { "properties": { "kind": { "const": "agent" } } },
    "knowledge":  {
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "agent" },
            "knowledge": {
              "type": "array",
              "items": { "$ref": "#/$defs/packageRef" }
            }
          }
        },
        {
          "properties": {
            "kind": { "const": "knowledge" },
            "knowledge": { "$ref": "#/$defs/knowledgeMetadata" }
          }
        }
      ]
    },
    "memory":  {
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "agent" },
            "memory": {
              "type": "array",
              "items": { "$ref": "#/$defs/packageRef" }
            }
          }
        },
        {
          "properties": {
            "kind": { "const": "memory" },
            "memory": { "$ref": "#/$defs/memoryMetadata" }
          }
        }
      ]
    },
    "profiles":   { "properties": { "kind": { "const": "agent" } } },
    "entrypoint": {
      "properties": { "kind": { "const": "tool" } }
    },
    "inputs":     { "properties": { "kind": { "const": "tool" } } },
    "outputs":    { "properties": { "kind": { "const": "tool" } } },
    "files":      { "properties": { "kind": { "const": "tool" } } },
    "runtime":    { "properties": { "kind": { "const": "tool" } } },
    "skill":      { "properties": { "kind": { "const": "skill" } } },
    "template":   { "properties": { "kind": { "const": "template" } } }
  },

  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "kind": { "type": "string", "enum": ["agent", "tool", "template", "skill", "knowledge", "memory"] },
    "name": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string" },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageRef" }
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageRef" }
    },
    "knowledge": {
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/packageRef" }
        },
        {
          "$ref": "#/$defs/knowledgeMetadata"
        }
      ]
    },
    "memory": {
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/packageRef" }
        },
        {
          "$ref": "#/$defs/memoryMetadata"
        }
      ]
    },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageRef" }
    },
    "examples": {
      "type": "array",
      "items": { "$ref": "#/$defs/promptExample" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args"],
      "properties": {
        "command": {
          "type": "string",
          "description": "Bare interpreter name or absolute path to it.",
          "anyOf": [
            { "enum": ["node", "nodejs", "python", "python3"] },
            { "pattern": "^(/|[A-Za-z]:\\\\\\\\|\\\\\\\\\\\\\\\\).+" }
          ]
        },
        "args": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "timeout_ms": { "type": "number" },
        "env": { "type": "object" }
      }
    },
    "inputs": { "type": "object" },
    "outputs": { "type": "object" },

    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vars": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/envVar" }
        }
      }
    },

    "readme": { "type": "string", "minLength": 1 },
    "skill": { "$ref": "#/$defs/skillMetadata" },
    "template": { "$ref": "#/$defs/templateMetadata" },

    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spdx": {
          "type": "string",
          "description": "SPDX identifier or expression (e.g., MIT, Apache-2.0, MIT OR Apache-2.0)",
          "minLength": 1
        },
        "file": { "type": "string", "minLength": 1 }
      }
    }
  },

  "required": ["kind", "name", "version", "description"],

  "oneOf": [
    {
      "properties": { "kind": { "const": "agent" } },
      "required": ["tools"]
    },
    {
      "properties": { "kind": { "const": "tool" } },
      "required": ["entrypoint", "inputs", "outputs", "files"]
    },
    {
      "properties": { "kind": { "const": "template" } },
      "required": ["template"]
    },
    {
      "properties": { "kind": { "const": "skill" } },
      "required": ["skill"]
    },
    {
      "properties": { "kind": { "const": "knowledge" } },
      "required": ["knowledge"]
    },
    {
      "properties": { "kind": { "const": "memory" } },
      "required": ["memory"]
    }
  ]
}
