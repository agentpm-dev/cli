{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/agentpm-dev/cli/refs/heads/main/schemas/agentpm.manifest.schema.json",
  "type": "object",
  "additionalProperties": false,

  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version"],
      "properties": {
        "type": { "type": "string", "enum": ["python", "node"] },
        "version": {
          "type": "string",
          "description": "Minimum required runtime version",
          "pattern": "^\\d+(\\.\\d+){0,2}$"
        }
      }
    },
    "envVar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "description"],
      "properties": {
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "default": { "type": "string" }
      }
    }
  },

  "dependentSchemas": {
    "tools":      { "properties": { "kind": { "const": "agent" } } },
    "entrypoint": {
      "properties": { "kind": { "const": "tool" } }
    },
    "inputs":     { "properties": { "kind": { "const": "tool" } } },
    "outputs":    { "properties": { "kind": { "const": "tool" } } },
    "files":      { "properties": { "kind": { "const": "tool" } } },
    "runtime":    { "properties": { "kind": { "const": "tool" } } }
  },

  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "kind": { "type": "string", "enum": ["agent", "tool"] },
    "name": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string" },
    "tools": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "pattern": "^@[a-z][a-z0-9-]{0,63}/[a-z][a-z0-9-]{0,63}(?:@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:\\.(0|[1-9]\\d*))?(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)?$"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "pattern": "^@[a-z][a-z0-9-]{0,63}/[a-z][a-z0-9-]{0,63}$" },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:\\.(0|[1-9]\\d*))?(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
              }
            }
          }
        ]
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "args"],
      "properties": {
        "command": {
          "type": "string",
          "description": "Bare interpreter name or absolute path to it.",
          "anyOf": [
            { "enum": ["node", "nodejs", "python", "python3"] },
            { "pattern": "^(/|[A-Za-z]:\\\\\\\\|\\\\\\\\\\\\\\\\).+" }
          ]
        },
        "args": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cwd": { "type": "string" },
        "timeout_ms": { "type": "number" },
        "env": { "type": "object" }
      }
    },
    "inputs": { "type": "object" },
    "outputs": { "type": "object" },

    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vars": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/envVar" }
        }
      }
    }
  },

  "required": ["kind", "name", "version", "description"],

  "oneOf": [
    {
      "properties": { "kind": { "const": "agent" } },
      "required": ["tools"]
    },
    {
      "properties": { "kind": { "const": "tool" } },
      "required": ["entrypoint", "inputs", "outputs", "files"]
    }
  ]
}
