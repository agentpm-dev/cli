{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpackagemanager.com/contracts/package-release-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "kind",
    "name",
    "version",
    "manifestDigest",
    "artifacts"
  ],
  "properties": {
    "type": {
      "const": "agentpm.package.release.v1"
    },
    "kind": {
      "enum": [
        "tool",
        "agent",
        "skill",
        "knowledge",
        "memory",
        "profile",
        "loop",
        "template"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^@[a-z][a-z0-9-]{0,63}/[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "manifestDigest": {
      "$ref": "#/$defs/digest"
    },
    "pythonResolutionDigest": {
      "$ref": "#/$defs/digest"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "target": {
                "const": "aarch64-apple-darwin"
              }
            },
            "required": ["target"]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "target": {
                "const": "x86_64-apple-darwin"
              }
            },
            "required": ["target"]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "target": {
                "const": "x86_64-pc-windows-msvc"
              }
            },
            "required": ["target"]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "target": {
                "const": "x86_64-unknown-linux-gnu"
              }
            },
            "required": ["target"]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "target": {
                "const": "any"
              }
            },
            "required": ["target"]
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "digest", "size", "contentType", "format"],
      "properties": {
        "target": {
          "enum": [
            "aarch64-apple-darwin",
            "x86_64-apple-darwin",
            "x86_64-pc-windows-msvc",
            "x86_64-unknown-linux-gnu",
            "any"
          ]
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contentType": {
          "const": "application/gzip"
        },
        "format": {
          "const": "tar.gz"
        }
      }
    }
  }
}
