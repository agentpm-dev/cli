{
  "$schema": "https://raw.githubusercontent.com/agentpm-dev/cli/main/schemas/agentpm.manifest.schema.json",
  "kind": "tool",
  "name": "m15-order-check",
  "version": "0.1.0",
  "description": "Development-only signed release installation verification.",
  "entrypoint": {"command": "python", "args": ["-u", "tool.py"], "timeout_ms": 30000},
  "runtime": {"type": "python", "version": "3.11", "dependencies": ["pydantic==2.11.7"]},
  "files": ["tool.py", "README.md"],
  "inputs": {
    "type": "object",
    "properties": {"quantity": {"type": "integer", "minimum": 1}, "unit_price": {"type": "number", "exclusiveMinimum": 0}},
    "required": ["quantity", "unit_price"],
    "additionalProperties": false
  },
  "outputs": {
    "type": "object",
    "properties": {"total": {"type": "number"}},
    "required": ["total"],
    "additionalProperties": false
  },
  "readme": "README.md",
  "license": {"spdx": "MIT"}
}
